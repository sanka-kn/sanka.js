{
    "name": "sanka",
    "version": "0.1.0",
    "description": "Kannada utilities",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sanka-kn/sanka.js.git"
    },
    "author": "Aravinda VK (https://aravindavk.in)",
    "license": "MIT",
    "bugs": {
